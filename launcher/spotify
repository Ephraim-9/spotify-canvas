#!/usr/bin/bash
# Optional Spotify wrapper for Linux/Wayland setups where Spotify's GPU process crashes.
# --disable-gpu-sandbox: GPU sandbox fix.
# --disable-accelerated-video-decode: on some Mesa/Wayland setups the GPU process segfaults in
#   dri2_initialize_wayland while setting up hardware video decode.
# Override the install dir with SPOTIFY_DIR if Spotify lives somewhere else.
dir=${SPOTIFY_DIR:-}
if [[ -z $dir ]]; then
    for d in /usr/lib64/spotify-client /usr/share/spotify /opt/spotify; do
        [[ -x $d/spotify ]] && { dir=$d; break; }
    done
fi
[[ -n $dir ]] || { echo "spotify: install not found, set SPOTIFY_DIR" >&2; exit 1; }
export LD_LIBRARY_PATH="$dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
flags=()
for f in --disable-gpu-sandbox --disable-accelerated-video-decode; do
    [[ " $* " == *" $f "* ]] || flags+=("$f")
done
exec "$dir/spotify" "${flags[@]}" "$@"
